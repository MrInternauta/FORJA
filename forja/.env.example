# ============================================================
# FORJA - variables de entorno (copiar a .env)
# ============================================================

# ===== API (apps/api) =====
PORT=3001
CORS_ORIGIN=http://localhost:3000

# DATABASE_URL sirve igual en los DOS modos de base de datos, porque ambos
# exponen Postgres en el puerto 54322 del host:
#   A) Stack Supabase completo:   supabase start        (Auth+Storage+Studio)
#   B) Solo Postgres via compose: docker compose up db  (migraciones auto-aplicadas)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321
# Modo A (claves asimetricas, default en Supabase): dejar VACIO -> la API
#   valida contra el JWKS publico.
# Modo B (sin Supabase Auth): definir un secreto HS256 de desarrollo y firmar
#   tokens de prueba con el (ver README > "Base de datos"). NUNCA en produccion.
SUPABASE_JWT_SECRET=

# --- Solo si levantas api/web EN CONTENEDOR contra el stack de `supabase start`
# (modo A). Reescriben las URLs de arriba, que son relativas al host:
#   docker compose up --build --no-deps api web
# API_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# API_SUPABASE_URL=http://host.docker.internal:54321

# Password del servicio `db` de compose (modo B)
POSTGRES_PASSWORD=postgres

# ===== Web (apps/web) — variables publicas, se hornean en build =====
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
